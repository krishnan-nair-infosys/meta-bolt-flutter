From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] third_party: Disable sdbus-cpp when ENABLE_DBUS is OFF

--- a/third_party/CMakeLists.txt
+++ b/third_party/CMakeLists.txt
@@ -1,3 +1,10 @@
+
+# Disable sdbus-cpp if DBus support is disabled
+if (NOT ENABLE_DBUS)
+    message(STATUS "DBus disabled - skipping sdbus-cpp")
+    return()
+endif()
+
 # Existing content continues below
